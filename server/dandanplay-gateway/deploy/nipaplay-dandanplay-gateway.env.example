LISTEN_ADDR=127.0.0.1:18081
DANDANPLAY_UPSTREAM_BASE=https://api.dandanplay.net
DANDANPLAY_APP_ID=nipaplayv1
# Prefer setting DANDANPLAY_APP_SECRET after the upstream key is rotated.
# Until then, the service can load the existing key from the legacy endpoint.
DANDANPLAY_APP_SECRET_URLS=https://kurisu.aimes-soft.com/nipaplay.php,https://nipaplay.aimes-soft.com/nipaplay.php
ALLOW_UNKNOWN_API_V2=true
# Every upstream API requires authentication. POST login/register are the only
# anonymous account entry points; renewal requires the existing bearer token.
ACCOUNT_REQUESTS_PER_MINUTE=120
IP_REQUESTS_PER_MINUTE=300
GLOBAL_REQUESTS_PER_MINUTE=3000
MAX_REQUEST_BYTES=8388608
RUST_LOG=info
