# Interface/port to listen on. Bind loopback and put nginx in front; the
# coordinator trusts X-Real-IP / X-Forwarded-For from that proxy.
MESH_LISTEN_ADDR=127.0.0.1:18082

# SQLite database and the Ed25519 issuing key pair.
MESH_DATABASE_PATH=/var/lib/nipaplay-mesh-coordinator/mesh.db
MESH_CA_CERT_FILE=/opt/nipaplay-mesh-coordinator/ca.crt.pem
MESH_CA_KEY_FILE=/etc/nipaplay-mesh-coordinator/ca.key.pem

# Short device certificate lifetime and advertised heartbeat cadence.
# MESH_HEARTBEAT_INTERVAL_SECONDS is clamped to a 900 second minimum.
MESH_CERT_VALIDITY_SECONDS=604800
MESH_HEARTBEAT_INTERVAL_SECONDS=900
MESH_ADDRESS_DEFAULT_TTL_SECONDS=3600
# Address candidates are short-lived hints. The server enforces a hard 2 hour
# cap regardless of this value.
MESH_ADDRESS_MAX_TTL_SECONDS=7200

# Rate limits: per account (hourly) and per IP (per minute).
MESH_REGISTER_PER_HOUR=10
MESH_RENEW_PER_HOUR=24
MESH_ADDRESSES_PER_HOUR=60
MESH_DEVICES_PER_HOUR=120
MESH_IP_REQUESTS_PER_MINUTE=300
MESH_TRUST_PROXY_HEADERS=true

# NipaPlay gateway owns the AppSecret and signs upstream requests.
# Same-host gateway; alternatively https://nipaplay.aimes-soft.com/dandanplay.
# The coordinator preserves the base path prefix and sends only the user Bearer.
DANDANPLAY_GATEWAY_BASE=http://127.0.0.1:18081
# JSON Pointer to the stable user ID in a JWT accepted by /playhistory.
# Confirm claim names/types using the App host's Debug startup diagnostic:
# NIPAPLAY_DEBUG_DANDANPLAY_CLAIM_NAMES=1 (see lib/next/mesh/README.md).
MESH_ACCOUNT_CLAIM_POINTER=/userId

RUST_LOG=info
