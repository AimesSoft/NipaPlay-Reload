#!/usr/bin/env python3
"""NipaPlay's live Action client. Python 3.9+, standard library only.

On Windows use: python nipa ...
Connection data belongs outside this repository; NIPAPLAY_ENDPOINT_FILE can
select another credential file. No persistent client session or background work.
"""
import argparse
import base64
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import sys
import subprocess
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

OUTPUT_BUDGET_BYTES = 24 * 1024


def compact(value):
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"))


def short_text(value, limit=160):
    raw = value.encode("utf-8")
    return value if len(raw) <= limit else raw[:limit].decode("utf-8", "ignore") + "…"


def output_result(data, full=False):
    """Budget the redacted serialization, including previews and metadata."""
    payload = compact(data)
    size = len(payload.encode("utf-8"))
    if full or size <= OUTPUT_BUDGET_BYTES:
        print(payload)
        return
    records = Path(__file__).resolve().parent / "records"
    records.mkdir(exist_ok=True)
    descriptor, name = tempfile.mkstemp(prefix="nipa-", suffix=".json", dir=records)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(payload)
    remaining = [50]
    def preview(value, depth=0):
        if remaining[0] <= 0 or depth >= 5:
            return "…"
        remaining[0] -= 1
        if isinstance(value, dict):
            return {short_text(str(k), 80): preview(v, depth + 1)
                    for k, v in list(value.items())[:8]}
        if isinstance(value, list):
            return [preview(v, depth + 1) for v in value[:3]]
        return short_text(value) if isinstance(value, str) else value
    def shape(value):
        if isinstance(value, dict):
            return {"type": "object", "fields": len(value),
                    "keys": [short_text(str(k), 80) for k in list(value)[:8]]}
        if isinstance(value, list):
            return {"type": "array", "items": len(value)}
        return {"type": type(value).__name__}
    summary = {"outputStored": True, "bytes": size, "budgetBytes": OUTPUT_BUDGET_BYTES,
               "file": name, "structure": shape(data), "preview": preview(data),
               "next": "Read selected fields/items from file; --output-full forces full terminal output."}
    if isinstance(data, dict):
        summary["fields"] = {short_text(str(k), 80): shape(v) for k, v in list(data.items())[:8]}
        if "status" in data:
            summary["status"] = short_text(str(data["status"]))
    if len(compact(summary).encode("utf-8")) > OUTPUT_BUDGET_BYTES:
        summary["preview"] = short_text(compact(summary["preview"]), 4096)
    print(compact(summary))


def instruction_sizes():
    root = Path(__file__).resolve().parent
    agents = root / "AGENTS.md"
    result = {"AGENTS.md": {"bytes": agents.stat().st_size if agents.is_file() else None,
                            "limitBytes": 32768,
                            "scope": "Codex project documents share this limit"}}
    memory = root / "memory"
    if memory.is_dir():
        sizes = {name: (memory / name).stat().st_size if (memory / name).is_file() else 0
                 for name in ("preferences.md", "MEMORY.md")}
        result["memory"] = {"residentBytes": sum(sizes.values()), "files": sizes}
    return result


def repair_hint(data, action, inputs):
    if data.get("status") == "failed":
        data["repair"] = {"describe": "./nipa describe " + action,
                          "parameters": "Read error.violations; correct the named fields and retry."}
        if action in {"state.query", "state.describe"}:
            data["repair"]["view"] = ("./nipa call state.describe " + compact({"view": inputs["view"]})
                                      if "view" in inputs else "./nipa describe state")
            if "unknown_view" in data.get("error", {}).get("message", ""):
                data["repair"]["view"] = "./nipa call state.describe '{}' lists registered views; use one of those names."
    return data


def endpoint_file():
    override = os.environ.get("NIPAPLAY_ENDPOINT_FILE")
    if override:
        return Path(override).expanduser()
    # A lab harness remains connected to its own instance in a fresh shell.
    for parent in Path(__file__).resolve().parents:
        marker = parent / "lab-profile.json"
        if marker.is_file():
            return Path(json.loads(marker.read_text())["endpointFile"])
    # A headless host keeps endpoint.json beside headless.json; its harness is <data>/harness.
    for parent in Path(__file__).resolve().parents:
        if (parent / "headless.json").is_file():
            return parent / "endpoint.json"
    profile = os.environ.get("NIPAPLAY_PROFILE")
    if profile is not None:
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", profile):
            raise ValueError("Invalid NIPAPLAY_PROFILE")
        if sys.platform != "darwin":
            raise ValueError("Lab profiles require macOS")
        return Path.home() / "Library" / "Application Support" / "NipaPlay" / "LabProfiles" / profile / "endpoint.json"
    if os.name == "nt":
        return Path(os.environ["APPDATA"]) / "NipaPlay" / "endpoint.json"
    return Path.home() / ".config" / "nipaplay" / "endpoint.json"


def redact(value, secrets=()):
    """Remove named secrets, known connection values and authenticated URLs."""
    if isinstance(value, dict):
        return {redact(str(k), secrets): v if k in {"inputSchema", "outputSchema"} else "[redacted]" if re.search(
            r"password|secret|token|cookie|authorization|api[_-]?key|passkey", str(k), re.I)
                else redact(v, secrets) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, secrets) for v in value]
    if not isinstance(value, str):
        return value
    def public_url(match):
        raw = match.group(0)
        try:
            uri = urllib.parse.urlsplit(raw)
            names = [k for k, _ in urllib.parse.parse_qsl(uri.query)]
            names += [k for k, _ in urllib.parse.parse_qsl(uri.fragment)]
            private = (uri.username is not None or uri.password is not None
                       or any(re.search(r"pass|auth|token|secret|cookie|sess|key|sig|credential|secure|hash|private|uid|^sid$|^code$", k, re.I) for k in names)
                       or (any(re.fullmatch(r"(announce|scrape|rss|feed|torrentrss|download|dl)(\.php)?", seg, re.I) for seg in uri.path.split("/"))
                           and any(re.fullmatch(r"[A-Za-z0-9_-]{24,}", seg) for seg in uri.path.split("/"))))
            return "[redacted URL]" if private else raw
        except ValueError:
            return "[redacted URL]"
    value = re.sub(r"(?<![a-zA-Z0-9+.-])[a-zA-Z][a-zA-Z0-9+.-]{0,31}://[^\s<>\"'\\]+", public_url, value)
    for secret in sorted((s for s in secrets if s), key=len, reverse=True):
        for form in {secret, urllib.parse.quote(secret, safe=""),
                     urllib.parse.quote_plus(secret)}:
            value = value.replace(form, "[redacted]")
    value = re.sub(r"\b(Bearer|Basic)\s+[^\s\"',}]+", r"\1 [redacted]", value, flags=re.I)
    value = re.sub(r"(?i)((?:password|secret|token|cookie|authorization|api[_-]?key|passkey)[\"']?\s*[=:]\s*)[^\s,}]+",
                   r"\1[redacted]", value)
    return value


def json_input(text):
    if text.startswith("@"):
        text = Path(text[1:]).expanduser().read_text(encoding="utf-8")
    value = json.loads(text)
    if not isinstance(value, dict):
        raise ValueError("Action input must be a JSON object")
    return value



def busy(reason):
    """NipaPlay is running but this request got no answer."""
    return ("NipaPlay is running but did not answer this request (" + reason + "); "
            "it may be busy. Reads can be retried; after a write, check the task or "
            "state before repeating it.")

class Client:
    def __init__(self):
        connection = json.loads(endpoint_file().read_text(encoding="utf-8"))
        self.url = connection["url"]
        self.token = connection["token"]
        address = urllib.parse.urlsplit(self.url)
        if (address.scheme != "http" or address.hostname != "127.0.0.1"
                or address.username or address.password or address.path != "/harness"):
            raise ValueError("Expected a local NipaPlay /harness endpoint")
        # The local endpoint must never be sent through HTTP_PROXY.
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        self.device = None

    def request(self, operation, **fields):
        # The socket timeout counts silence, and a wait answers only at its end.
        timeout = 65
        if fields.get("action") == "download.wait_files":
            waited = (fields.get("input") or {}).get("waitSeconds", 300)
            timeout = (waited if isinstance(waited, int) else 300) + 35
        body = json.dumps(dict(operation=operation, **fields)).encode("utf-8")
        request = urllib.request.Request(self.url, data=body, headers={
            "Authorization": "Bearer " + self.token, "Content-Type": "application/json",
            **({"X-NipaPlay-Chat": os.environ["NIPAPLAY_CHAT"]}
               if os.environ.get("NIPAPLAY_CHAT") else {}),
            **({"X-Nipa-Hook": os.environ["NIPAPLAY_HOOK"]} if os.environ.get("NIPAPLAY_HOOK") else {})})
        try:
            with self.opener.open(request, timeout=timeout) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            details = json.load(error)
            raise RuntimeError("NipaPlay HTTP " + str(error.code) + ": " + compact(details)) from None
        except urllib.error.URLError as error:
            if isinstance(error.reason, ConnectionRefusedError):
                raise RuntimeError("Cannot connect; run NipaPlay and enable Next in Labs") from None
            raise RuntimeError(busy(str(error.reason))) from None
        except (TimeoutError, ConnectionError, http.client.HTTPException) as error:
            raise RuntimeError(busy(type(error).__name__)) from None

    def result(self, value):
        if value.get("status") != "completed":
            raise ValueError(json.dumps(value, ensure_ascii=False))
        return value["result"]

    def select_device(self, name):
        devices = self.result(self.call("mesh.devices", {}))["devices"]
        matches = [d for d in devices if name in (d["deviceId"], d.get("device_name"))]
        if len(matches) != 1:
            raise ValueError("Device name/ID must match exactly one Mesh device")
        self.device = matches[0]
        if not self.device["online"]:
            raise ValueError("Mesh device is offline; its cached catalog is not live")

    def catalog(self, full=True):
        if self.device:
            facts = self.device.get("description", {}).get("capabilities", {})
            readiness = {a["id"]: a for a in facts.get("result", {}).get("actions", [])}
            keys = ("available", "availabilityScope", "availabilityReason", "requiredHostSetup",
                    "remoteCallable", "requiredUserPresence", "lifecycle", "replacement")
            catalog = {"actions": [{**a, **{k: readiness[a["id"]][k] for k in keys
                if k in readiness.get(a["id"], {})}} for a in self.device["actions"]]}
            return catalog if full else catalog_summary(catalog)
        catalog = self.request("list", full=full)
        return catalog if full else catalog_summary(catalog)

    def describe(self, action):
        if not self.device:
            return self.request("describe", action=action)
        matches = [a for a in self.catalog()["actions"] if a["id"] == action]
        if not matches:
            return self.result(self.call("capability.describe", {"family": action}))
        return matches[0]

    def call(self, action, inputs, execute=False):
        if not self.device:
            return repair_hint(self.request("call", action=action, input=inputs, execute=execute), action, inputs)
        if action not in {a["id"] for a in self.catalog()["actions"]}:
            raise ValueError("Unknown remote Action: " + action + ". Run ./nipa --device NAME list, then describe ACTION.")
        spec = self.describe(action)
        gateway = "mesh.invoke_destructive" if spec["effect"] == "destructive" else "mesh.invoke"
        return repair_hint(self.request("call", action=gateway, input={
            "deviceId": self.device["deviceId"], "action": action, "input": inputs}, execute=execute), action, inputs)

    def watch(self, task, seconds):
        end = time.monotonic() + seconds
        snapshot = self.call("task.get", {"jobId": task})
        while snapshot.get("status") == "completed":
            job = snapshot["result"]["job"]
            remaining = end - time.monotonic()
            if job["state"] in {"succeeded", "failed", "cancelled", "needs_decision", "waiting_user", "paused"} or remaining <= 0:
                return snapshot
            snapshot = self.call("task.wait", {"jobId": task, "afterRevision": job["revision"],
                                                "timeoutMs": max(0, int(remaining * 1000))})
        return snapshot

    def sync_repository(self, repository, ref):
        if not self.device:
            raise ValueError("sync-repository requires --device")
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_./-]*", ref):
            raise ValueError("Expected a named Git revision, such as HEAD or refs/heads/main")
        # Git bundle carries objects and a selected ref, never .git/config,
        # local credential files, untracked files or this process environment.
        repository = str(Path(repository).expanduser().resolve())
        def git(*arguments):
            result = subprocess.run(["git", "-C", repository, *arguments],
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if result.returncode:
                raise ValueError("Git bundle preparation failed: " + redact(result.stderr.decode("utf-8", "replace")))
            return result.stdout.decode("utf-8").strip()
        revision = git("rev-parse", "--verify", ref + "^{commit}")
        if not re.fullmatch(r"[a-f0-9]{40,64}", revision):
            raise ValueError("Invalid Git commit")
        with tempfile.TemporaryDirectory(prefix="nipa-bundle-") as temporary:
            bundle = Path(temporary) / "repository.bundle"
            git("bundle", "create", str(bundle), ref)
            if bundle.stat().st_size > 67108864:
                raise ValueError("Git bundle exceeds 64 MiB")
            payload = bundle.read_bytes()
        digest = hashlib.sha256(payload).hexdigest()
        receipt = None
        for offset in range(0, len(payload), 393216):
            receipt = self.result(self.call("program.repository.receive", {
                "sha256": digest, "offset": offset, "totalBytes": len(payload),
                "data": base64.b64encode(payload[offset:offset + 393216]).decode("ascii")}))
        return {"revision": revision, "ref": ref, "bundle": receipt}


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        print(compact({"error": message, "repair": self.prog + " --help"}))
        raise SystemExit(2)


def catalog_summary(catalog):
    # An action is available, needs no setup and has no replacement unless it
    # says so; leaving those defaults out keeps the list inside one terminal budget.
    defaults = {"available": True, "availabilityReason": None, "requiredHostSetup": []}
    return {"actions": [{k: a[k] for k in ("id", "effect", "title", "available", "availabilityReason",
                        "requiredHostSetup", "lifecycle", "replacement")
                        if k in a and (k not in defaults or a[k] != defaults[k])}
                        for a in catalog["actions"]]}


def all_tasks(client):
    """Every task, newest first: task.list answers in pages (an older device answers whole)."""
    jobs, offset = [], 0
    while True:
        page = client.call("task.list", {"limit": 500, "offset": offset})
        if page.get("status") != "completed":
            return client.call("task.list", {}) if offset == 0 else page
        result = page["result"]
        jobs.extend(result["jobs"])
        offset = result.get("nextOffset")
        if offset is None:
            return {**page, "result": {k: v for k, v in result.items() if k != "nextOffset"} | {"jobs": jobs}}


def task_summary(envelope):
    if envelope.get("status") != "completed":
        return envelope
    jobs = envelope["result"]["jobs"]
    counts = {}
    active = []
    for job in jobs:
        state = job["state"]
        counts[state] = counts.get(state, 0) + 1
        if state not in {"succeeded", "failed", "cancelled"}:
            active.append({k: job.get(k) for k in
                           ("jobId", "title", "state", "phase", "progress")})
    return {"total": len(jobs), "byState": counts,
            "activeTotal": len(active), "active": active[:10]}


def chat_command(client, args):
    """Talk to Nipa on a headless host. A turn runs in the host in the background;
    these calls start it, wait for it and read it. Only the person at the host can
    send or stop (Nipa's own calls are refused)."""
    thread = {"threadId": args.thread} if getattr(args, "thread", None) else {}
    def done(envelope):
        if envelope.get("status") != "completed":
            return envelope
        return envelope["result"]
    verb = args.chat_command
    if verb in ("new", "main", "list"):
        return done(client.call("chat.session." + verb, {}))
    if verb == "switch":
        return done(client.call("chat.session.switch", {"threadId": args.thread_id}))
    if verb == "status":
        return done(client.call("chat.status", dict(thread, waitSeconds=min(55, max(0, args.wait)))))
    if verb == "read":
        return done(client.call("chat.read", dict(thread, turns=args.turns)))
    if verb == "stop":
        return done(client.call("chat.stop", thread))
    if verb == "process":
        if not thread:
            status = client.call("chat.status", {})
            if status.get("status") != "completed":
                return status
            thread = {"threadId": status["result"]["threadId"]}
        return done(client.call("chat.turn.process", dict(thread, turnId=args.turn_id)))
    # say
    text = sys.stdin.read() if args.text == "-" else json_text(args.text)
    sent = client.call("chat.send", dict(thread, text=text))
    if sent.get("status") != "completed" or args.wait <= 0:
        return done(sent)
    sent = sent["result"]
    end = time.monotonic() + args.wait
    status = None
    while True:
        remaining = end - time.monotonic()
        status = client.call("chat.status", {"threadId": sent["threadId"],
                                             "waitSeconds": int(min(55, max(0, remaining)))})
        if status.get("status") != "completed":
            return status
        if not status["result"]["busy"] or time.monotonic() >= end:
            break
    result = {"sent": sent, "turn": status["result"]["turn"], "busy": status["result"]["busy"]}
    if not result["busy"]:
        read = client.call("chat.read", {"threadId": sent["threadId"], "turns": 1})
        if read.get("status") == "completed" and read["result"]["turns"]:
            items = read["result"]["turns"][-1]["items"]
            result["reply"] = "\n".join(i["text"] for i in items if i["type"] == "agentMessage")
            result["steps"] = [{"command": i["command"], "status": i["status"], "exitCode": i["exitCode"]}
                               for i in items if i["type"] == "commandExecution"]
    else:
        result["next"] = "The turn is still running: ./nipa chat status --wait 55, then ./nipa chat read."
    return result


def json_text(text):
    if text.startswith("@"):
        return Path(text[1:]).expanduser().read_text(encoding="utf-8")
    return text


def main():
    parser = JsonArgumentParser(description=__doc__)
    parser.add_argument("--output-full", action="store_true", help="Bypass the 24 KiB terminal budget")
    parser.add_argument("--device", help="Exact Mesh device name or ID")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status").add_argument(
        "--full", action="store_true", help="Include full task snapshots and receipts")
    commands.add_parser("list").add_argument(
        "--full", action="store_true", help="Include all descriptions and schemas")
    commands.add_parser("describe").add_argument("action")
    call = commands.add_parser("call")
    call.add_argument("action")
    call.add_argument("input", nargs="?", default="{}", help="JSON object or @file")
    call.add_argument("--execute", action="store_true")
    query = commands.add_parser("query")
    query.add_argument("view")
    query.add_argument("input", nargs="?", default="{}")
    watch = commands.add_parser("watch")
    watch.add_argument("task")
    watch.add_argument("--seconds", type=int, default=40, choices=range(0, 61), metavar="0..60")
    sync = commands.add_parser("sync-repository", help="Transfer a committed Git revision as a bundle; no checkout/merge")
    sync.add_argument("--repository", default=".")
    sync.add_argument("--ref", default="HEAD")
    chat = commands.add_parser("chat", help="Talk to Nipa on this headless host (the person's tool)")
    chat_commands = chat.add_subparsers(dest="chat_command", required=True)
    for name in ("new", "main", "list"):
        chat_commands.add_parser(name)
    chat_commands.add_parser("switch").add_argument("thread_id")
    say = chat_commands.add_parser("say", help="Send TEXT (or @file, or - for standard input)")
    say.add_argument("text")
    say.add_argument("--thread")
    say.add_argument("--wait", type=int, default=0, metavar="SECONDS",
                     help="Wait up to SECONDS for the turn to end and print the reply and the commands she ran")
    status = chat_commands.add_parser("status")
    status.add_argument("--thread")
    status.add_argument("--wait", type=int, default=0, metavar="0..55")
    read = chat_commands.add_parser("read")
    read.add_argument("--thread")
    read.add_argument("--turns", type=int, default=3)
    chat_commands.add_parser("stop").add_argument("--thread")
    process = chat_commands.add_parser("process", help="Redacted commands and reasoning summaries of one turn")
    process.add_argument("turn_id")
    process.add_argument("--thread")
    for command_parser in commands.choices.values():
        command_parser.add_argument("--output-full", action="store_true", default=argparse.SUPPRESS,
                                    help="Bypass the 24 KiB terminal budget; results may be truncated by the caller")
    args = parser.parse_args()
    client = None
    try:
        client = Client()
        if args.device:
            client.select_device(args.device)
        if args.command == "status":
            if client.device:
                data = {"device": client.device, "tasks": all_tasks(client)}
                if not args.full:
                    data = {"device": {k: client.device.get(k) for k in
                                       ("deviceId", "device_name", "online")},
                            "actions": len(client.device["actions"]),
                            "tasks": task_summary(data["tasks"])}
            else:
                data = client.request("status", full=args.full)
                if not args.full:
                    data["tasks"] = task_summary(data["tasks"])
            data["instructions"] = instruction_sizes()
        elif args.command == "list":
            data = client.catalog(full=args.full)
        elif args.command == "describe":
            data = client.describe(args.action)
        elif args.command == "call":
            data = client.call(args.action, json_input(args.input), args.execute)
        elif args.command == "query":
            data = client.call("state.query", dict(json_input(args.input), view=args.view))
        elif args.command == "chat":
            data = chat_command(client, args)
        elif args.command == "sync-repository":
            data = client.sync_repository(args.repository, args.ref)
        else:
            data = client.watch(args.task, args.seconds)
        output_result(redact(data, [client.token]), args.output_full)
        return 1 if data.get("status") == "failed" else 0
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        output_result({"error": redact(str(error), [client.token] if client else [])}, args.output_full)
        return 1


if __name__ == "__main__":
    sys.stdout.reconfigure(encoding="utf-8")
    sys.exit(main())
