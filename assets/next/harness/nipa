#!/usr/bin/env python3
"""NipaPlay's live Action client. Python 3.9+, standard library only.

On Windows use: python nipa ...
Connection data belongs outside this repository; NIPAPLAY_ENDPOINT_FILE can
select another credential file. No persistent client session or background work.
"""
import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import subprocess
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request


def endpoint_file():
    override = os.environ.get("NIPAPLAY_ENDPOINT_FILE")
    if override:
        return Path(override).expanduser()
    # A lab harness remains connected to its own instance in a fresh shell.
    for parent in Path(__file__).resolve().parents:
        marker = parent / "lab-profile.json"
        if marker.is_file():
            return Path(json.loads(marker.read_text())["endpointFile"])
    profile = os.environ.get("NIPAPLAY_PROFILE")
    if profile is not None:
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,63}", profile):
            raise ValueError("Invalid NIPAPLAY_PROFILE")
        if sys.platform != "darwin":
            raise ValueError("Lab profiles require macOS")
        return Path.home() / "Library" / "Application Support" / "NipaPlay" / "LabProfiles" / profile / "endpoint.json"
    if os.name == "nt":
        return Path(os.environ["APPDATA"]) / "NipaPlay" / "endpoint.json"
    return Path.home() / ".config" / "nipaplay" / "endpoint.json"


def redact(value, secrets=()):
    """Remove named secrets, known connection values and authenticated URLs."""
    if isinstance(value, dict):
        return {redact(str(k), secrets): v if k in {"inputSchema", "outputSchema"} else "[redacted]" if re.search(
            r"password|secret|token|cookie|authorization|api[_-]?key|passkey", str(k), re.I)
                else redact(v, secrets) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v, secrets) for v in value]
    if not isinstance(value, str):
        return value
    def public_url(match):
        raw = match.group(0)
        try:
            uri = urllib.parse.urlsplit(raw)
            names = [k for k, _ in urllib.parse.parse_qsl(uri.query)]
            names += [k for k, _ in urllib.parse.parse_qsl(uri.fragment)]
            private = (uri.username is not None or uri.password is not None
                       or any(re.search(r"pass|auth|token|secret|cookie|sess|key|sig|credential|secure|hash|private|uid|^sid$|^code$", k, re.I) for k in names)
                       or (any(re.fullmatch(r"(announce|scrape|rss|feed|torrentrss|download|dl)(\.php)?", seg, re.I) for seg in uri.path.split("/"))
                           and any(re.fullmatch(r"[A-Za-z0-9_-]{24,}", seg) for seg in uri.path.split("/"))))
            return "[redacted URL]" if private else raw
        except ValueError:
            return "[redacted URL]"
    value = re.sub(r"(?<![a-zA-Z0-9+.-])[a-zA-Z][a-zA-Z0-9+.-]{0,31}://[^\s<>\"'\\]+", public_url, value)
    for secret in sorted((s for s in secrets if s), key=len, reverse=True):
        for form in {secret, urllib.parse.quote(secret, safe=""),
                     urllib.parse.quote_plus(secret)}:
            value = value.replace(form, "[redacted]")
    value = re.sub(r"\b(Bearer|Basic)\s+[^\s\"',}]+", r"\1 [redacted]", value, flags=re.I)
    value = re.sub(r"(?i)((?:password|secret|token|cookie|authorization|api[_-]?key|passkey)[\"']?\s*[=:]\s*)[^\s,}]+",
                   r"\1[redacted]", value)
    return value


def json_input(text):
    if text.startswith("@"):
        text = Path(text[1:]).expanduser().read_text(encoding="utf-8")
    value = json.loads(text)
    if not isinstance(value, dict):
        raise ValueError("Action input must be a JSON object")
    return value


class Client:
    def __init__(self):
        connection = json.loads(endpoint_file().read_text(encoding="utf-8"))
        self.url = connection["url"]
        self.token = connection["token"]
        address = urllib.parse.urlsplit(self.url)
        if (address.scheme != "http" or address.hostname != "127.0.0.1"
                or address.username or address.password or address.path != "/harness"):
            raise ValueError("Expected a local NipaPlay /harness endpoint")
        # The local endpoint must never be sent through HTTP_PROXY.
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        self.device = None

    def request(self, operation, **fields):
        body = json.dumps(dict(operation=operation, **fields)).encode("utf-8")
        request = urllib.request.Request(self.url, data=body, headers={
            "Authorization": "Bearer " + self.token, "Content-Type": "application/json",
            **({"X-NipaPlay-Chat": os.environ["NIPAPLAY_CHAT"]}
               if os.environ.get("NIPAPLAY_CHAT") else {}),
            **({"X-Nipa-Hook": os.environ["NIPAPLAY_HOOK"]} if os.environ.get("NIPAPLAY_HOOK") else {})})
        try:
            with self.opener.open(request, timeout=65) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            raise RuntimeError("NipaPlay returned HTTP " + str(error.code)) from None
        except (urllib.error.URLError, TimeoutError):
            raise RuntimeError("Cannot connect; run NipaPlay and enable Next in Labs") from None

    def result(self, value):
        if value.get("status") != "completed":
            raise ValueError(json.dumps(value, ensure_ascii=False))
        return value["result"]

    def select_device(self, name):
        devices = self.result(self.call("mesh.devices", {}))["devices"]
        matches = [d for d in devices if name in (d["deviceId"], d.get("device_name"))]
        if len(matches) != 1:
            raise ValueError("Device name/ID must match exactly one Mesh device")
        self.device = matches[0]
        if not self.device["online"]:
            raise ValueError("Mesh device is offline; its cached catalog is not live")

    def catalog(self, full=True):
        if self.device:
            catalog = {"actions": self.device["actions"]}
            return catalog if full else catalog_summary(catalog)
        catalog = self.request("list", full=full)
        return catalog if full else catalog_summary(catalog)

    def describe(self, action):
        if not self.device:
            return self.request("describe", action=action)
        matches = [a for a in self.catalog()["actions"] if a["id"] == action]
        if not matches:
            raise ValueError("Unknown Action: " + action)
        return matches[0]

    def call(self, action, inputs, execute=False):
        if not self.device:
            return self.request("call", action=action, input=inputs, execute=execute)
        spec = self.describe(action)
        gateway = "mesh.invoke_destructive" if spec["effect"] == "destructive" else "mesh.invoke"
        return self.request("call", action=gateway, input={
            "deviceId": self.device["deviceId"], "action": action, "input": inputs}, execute=execute)

    def watch(self, task, seconds):
        end = time.monotonic() + seconds
        snapshot = self.call("task.get", {"jobId": task})
        while snapshot.get("status") == "completed":
            job = snapshot["result"]["job"]
            remaining = end - time.monotonic()
            if job["state"] in {"succeeded", "failed", "cancelled", "needs_decision", "waiting_user", "paused"} or remaining <= 0:
                return snapshot
            snapshot = self.call("task.wait", {"jobId": task, "afterRevision": job["revision"],
                                                "timeoutMs": max(0, int(remaining * 1000))})
        return snapshot

    def sync_repository(self, repository, ref):
        if not self.device:
            raise ValueError("sync-repository requires --device")
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_./-]*", ref):
            raise ValueError("Expected a named Git revision, such as HEAD or refs/heads/main")
        # Git bundle carries objects and a selected ref, never .git/config,
        # local credential files, untracked files or this process environment.
        repository = str(Path(repository).expanduser().resolve())
        def git(*arguments):
            result = subprocess.run(["git", "-C", repository, *arguments],
                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if result.returncode:
                raise ValueError("Git bundle preparation failed: " + redact(result.stderr.decode("utf-8", "replace")))
            return result.stdout.decode("utf-8").strip()
        revision = git("rev-parse", "--verify", ref + "^{commit}")
        if not re.fullmatch(r"[a-f0-9]{40,64}", revision):
            raise ValueError("Invalid Git commit")
        with tempfile.TemporaryDirectory(prefix="nipa-bundle-") as temporary:
            bundle = Path(temporary) / "repository.bundle"
            git("bundle", "create", str(bundle), ref)
            if bundle.stat().st_size > 67108864:
                raise ValueError("Git bundle exceeds 64 MiB")
            payload = bundle.read_bytes()
        digest = hashlib.sha256(payload).hexdigest()
        receipt = None
        for offset in range(0, len(payload), 393216):
            receipt = self.result(self.call("program.repository.receive", {
                "sha256": digest, "offset": offset, "totalBytes": len(payload),
                "data": base64.b64encode(payload[offset:offset + 393216]).decode("ascii")}))
        return {"revision": revision, "ref": ref, "bundle": receipt}


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        print(json.dumps({"error": "Invalid command arguments; use --help"}))
        raise SystemExit(2)


def catalog_summary(catalog):
    return {"actions": [{k: a[k] for k in ("id", "effect", "title")}
                        for a in catalog["actions"]]}


def task_summary(envelope):
    if envelope.get("status") != "completed":
        return envelope
    jobs = envelope["result"]["jobs"]
    counts = {}
    active = []
    for job in jobs:
        state = job["state"]
        counts[state] = counts.get(state, 0) + 1
        if state not in {"succeeded", "failed", "cancelled"}:
            active.append({k: job.get(k) for k in
                           ("jobId", "title", "state", "phase", "progress")})
    return {"total": len(jobs), "byState": counts,
            "activeTotal": len(active), "active": active[:10]}


def main():
    parser = JsonArgumentParser(description=__doc__)
    parser.add_argument("--device", help="Exact Mesh device name or ID")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status").add_argument(
        "--full", action="store_true", help="Include full task snapshots and receipts")
    commands.add_parser("list").add_argument(
        "--full", action="store_true", help="Include all descriptions and schemas")
    commands.add_parser("describe").add_argument("action")
    call = commands.add_parser("call")
    call.add_argument("action")
    call.add_argument("input", nargs="?", default="{}", help="JSON object or @file")
    call.add_argument("--execute", action="store_true")
    query = commands.add_parser("query")
    query.add_argument("view")
    query.add_argument("input", nargs="?", default="{}")
    watch = commands.add_parser("watch")
    watch.add_argument("task")
    watch.add_argument("--seconds", type=int, default=40, choices=range(0, 61), metavar="0..60")
    sync = commands.add_parser("sync-repository", help="Transfer a committed Git revision as a bundle; no checkout/merge")
    sync.add_argument("--repository", default=".")
    sync.add_argument("--ref", default="HEAD")
    args = parser.parse_args()
    client = None
    try:
        client = Client()
        if args.device:
            client.select_device(args.device)
        if args.command == "status":
            if client.device:
                data = {"device": client.device, "tasks": client.call("task.list", {})}
                if not args.full:
                    data = {"device": {k: client.device.get(k) for k in
                                       ("deviceId", "device_name", "online")},
                            "actions": len(client.device["actions"]),
                            "tasks": task_summary(data["tasks"])}
            else:
                data = client.request("status", full=args.full)
                if not args.full:
                    data["tasks"] = task_summary(data["tasks"])
        elif args.command == "list":
            data = client.catalog(full=args.full)
        elif args.command == "describe":
            data = client.describe(args.action)
        elif args.command == "call":
            data = client.call(args.action, json_input(args.input), args.execute)
        elif args.command == "query":
            data = client.call("state.query", dict(json_input(args.input), view=args.view))
        elif args.command == "sync-repository":
            data = client.sync_repository(args.repository, args.ref)
        else:
            data = client.watch(args.task, args.seconds)
        print(json.dumps(redact(data, [client.token]), ensure_ascii=False, indent=2))
        return 1 if data.get("status") == "failed" else 0
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print(json.dumps({"error": redact(str(error), [client.token] if client else [])},
                         ensure_ascii=False))
        return 1


if __name__ == "__main__":
    sys.stdout.reconfigure(encoding="utf-8")
    sys.exit(main())
