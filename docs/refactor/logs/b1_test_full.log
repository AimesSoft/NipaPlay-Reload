              'import \'package:nipaplay/utils/fluent_icon_font_loader.dart\';\r\n'
              'import \'package:nipaplay/widgets/user_activity/adaptive_user_activity.dart\';\r\n'
              'import \'package:url_launcher/url_launcher.dart\';\r\n'
              '\r\n'
              'enum _BangumiSyncHelpService { dandanplay, nipaplay }\r\n'
              '\r\n'
              'class UnifiedAccountPage extends StatefulWidget {\r\n'
              '  const UnifiedAccountPage({super.key});\r\n'
              '\r\n'
              '  @override\r\n'
              '  State<UnifiedAccountPage> createState() => _UnifiedAccountPageState();\r\n'
              '}\r\n'
              '\r\n'
              'class _UnifiedAccountPageState extends State<UnifiedAccountPage>\r\n'
              '    with AccountPageController {\r\n'
              '  static const double _buttonHoverScale = 1.06;\r\n'
              '\r\n'
              '  bool _showDandanplayPhoneSection = true;\r\n'
              '  bool _isRefreshingDandanBangumiStatus = false;\r\n'
              '\r\n'
              '  bool get _isPhoneSurface =>\r\n'
              '      AppDisplaySurfaceScope.of(context) == AppDisplaySurface.phone;\r\n'
              '\r\n'
              '  @override\r\n'
              '  void initState() {\r\n'
              '    super.initState();\r\n'
              '    unawaited(_ensureFluentIconFonts());\r\n'
              '  }\r\n'
              '\r\n'
              '  Future<void> _ensureFluentIconFonts() async {\r\n'
              '    try {\r\n'
              '      await FluentIconFontLoader.instance.ensureLoaded();\r\n'
              '    } catch (error, stackTrace) {\r\n'
              '      debugPrint(\'个人中心加载 Fluent 图标字体失败: $error\');\r\n'
              '      debugPrintStack(stackTrace: stackTrace);\r\n'
              '    }\r\n'
              '  }\r\n'
              '\r\n'
              '  @override\r\n'
              '  void showMessage(String message) {\r\n'
              '    if (!mounted) return;\r\n'
              '    if (_isPhoneSurface) {\r\n'
              '      AdaptiveSnackBar.show(\r\n'
              '        context,\r\n'
              '        message: message,\r\n'
              '        type: AdaptiveSnackBarType.info,\r\n'
              '      );\r\n'
              '      return;\r\n'
              '    }\r\n'
              '    BlurSnackBar.show(context, message);\r\n'
              '  }\r\n'
              '\r\n'
              '  @override\r\n'
              '  void showLoginDialog() {\r\n'
              '    if (_isPhoneSurface) {\r\n'
              '      unawaited(_showCupertinoLoginDialog());\r\n'
              '      return;\r\n'
              '    }\r\n'
              '    unawaited(\r\n'
              '      _showFluentLoginDialog(\r\n'
              '        title: \'登录弹弹play账号\',\r\n'
              '        fields: [\r\n'
              '          LoginField(\r\n'
              '            key: \'username\',\r\n'
              '            label: \'用户名/邮箱\',\r\n'
              '            hint: \'请输入用户名或邮箱\',\r\n'
              '            initialValue: usernameController.text,\r\n'
              '          ),\r\n'
              '          LoginField(\r\n'
              '            key: \'password\',\r\n'
              '            label: \'密码\',\r\n'
              '            isPassword: true,\r\n'
              '            initialValue: passwordController.text,\r\n'
              '          ),\r\n'
              '        ],\r\n'
              '        actionText: \'登录\',\r\n'
              '        onSubmit: (values) async {\r\n'
              '          usernameController.text = values[\'username\'] ?? \'\';\r\n'
              '          passwordController.text = values[\'password\'] ?? \'\';\r\n'
              '          await performLogin();\r\n'
              '          return LoginResult(success: isLoggedIn);\r\n'
              '        },\r\n'
              '      ),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  @override\r\n'
              '  void showRegisterDialog() {\r\n'
              '    if (_isPhoneSurface) {\r\n'
              '      unawaited(_showCupertinoRegisterDialog());\r\n'
              '      return;\r\n'
              '    }\r\n'
              '    unawaited(\r\n'
              '      _showFluentLoginDialog(\r\n'
              '        title: \'注册弹弹play账号\',\r\n'
              '        fields: [\r\n'
              '          LoginField(\r\n'
              '            key: \'username\',\r\n'
              '            label: \'用户名\',\r\n'
              '            hint: \'5-20位英文或数字，首位不能为数字\',\r\n'
              '            initialValue: registerUsernameController.text,\r\n'
              '          ),\r\n'
              '          LoginField(\r\n'
              '            key: \'password\',\r\n'
              '            label: \'密码\',\r\n'
              '            hint: \'5-20位密码\',\r\n'
              '            isPassword: true,\r\n'
              '            initialValue: registerPasswordController.text,\r\n'
              '          ),\r\n'
              '          LoginField(\r\n'
              '            key: \'email\',\r\n'
              '            label: \'邮箱\',\r\n'
              '            hint: \'用于找回密码\',\r\n'
              '            initialValue: registerEmailController.text,\r\n'
              '          ),\r\n'
              '          LoginField(\r\n'
              '            key: \'screenName\',\r\n'
              '            label: \'昵称\',\r\n'
              '            hint: \'显示名称，不超过50个字符\',\r\n'
              '            initialValue: registerScreenNameController.text,\r\n'
              '          ),\r\n'
              '        ],\r\n'
              '        actionText: \'注册\',\r\n'
              '        onSubmit: (values) async {\r\n'
              '          registerUsernameController.text = values[\'username\'] ?? \'\';\r\n'
              '          registerPasswordController.text = values[\'password\'] ?? \'\';\r\n'
              '          registerEmailController.text = values[\'email\'] ?? \'\';\r\n'
              '          registerScreenNameController.text = values[\'screenName\'] ?? \'\';\r\n'
              '          try {\r\n'
              '            await performRegister();\r\n'
              '            return LoginResult(\r\n'
              '              success: isLoggedIn,\r\n'
              '              message: isLoggedIn ? \'注册成功\' : \'注册失败\',\r\n'
              '            );\r\n'
              '          } catch (error) {\r\n'
              '            return LoginResult(success: false, message: \'注册失败: $error\');\r\n'
              '          }\r\n'
              '        },\r\n'
              '      ),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  @override\r\n'
              '  void showDeleteAccountDialog(String deleteAccountUrl) {\r\n'
              '    if (_isPhoneSurface) {\r\n'
              '      unawaited(\r\n'
              '        AdaptiveAlertDialog.show(\r\n'
              '          context: context,\r\n'
              '          title: \'账号注销确认\',\r\n'
              '          message: \'账号注销为不可逆操作，将清除账号关联的所有数据。点击“继续注销”将在浏览器中打开注销页面。\',\r\n'
              '          actions: [\r\n'
              '            AlertAction(\r\n'
              '              title: \'取消\',\r\n'
              '              style: AlertActionStyle.cancel,\r\n'
              '              onPressed: () {},\r\n'
              '            ),\r\n'
              '            AlertAction(\r\n'
              '              title: \'继续注销\',\r\n'
              '              style: AlertActionStyle.destructive,\r\n'
              '              onPressed: () {\r\n'
              '                unawaited(\r\n'
              '                  _openExternalUrl(\r\n'
              '                    deleteAccountUrl,\r\n'
              '                    cannotOpenMessage: \'无法打开注销页面\',\r\n'
              '                  ),\r\n'
              '                );\r\n'
              '              },\r\n'
              '            ),\r\n'
              '            AlertAction(\r\n'
              '              title: \'已完成注销\',\r\n'
              '              style: AlertActionStyle.primary,\r\n'
              '              onPressed: () => unawaited(completeAccountDeletion()),\r\n'
              '            ),\r\n'
              '          ],\r\n'
              '        ),\r\n'
              '      );\r\n'
              '      return;\r\n'
              '    }\r\n'
              '\r\n'
              '    unawaited(\r\n'
              '      BlurDialog.show<void>(\r\n'
              '        context: context,\r\n'
              '        title: \'账号注销确认\',\r\n'
              '        content: \'账号注销不可逆，将永久删除账号及其关联数据。继续后会在浏览器中打开注销页面。\',\r\n'
              '        actions: [\r\n'
              '          BlurButton(\r\n'
              '            icon: fluent.FluentIcons.cancel,\r\n'
              '            text: \'取消\',\r\n'
              '            flatStyle: true,\r\n'
              '            hoverScale: _buttonHoverScale,\r\n'
              '            onTap: () => Navigator.of(context).pop(),\r\n'
              '          ),\r\n'
              '          BlurButton(\r\n'
              '            icon: fluent.FluentIcons.delete,\r\n'
              '            text: \'继续注销\',\r\n'
              '            flatStyle: true,\r\n'
              '            hoverScale: _buttonHoverScale,\r\n'
              '            onTap: () {\r\n'
              '              Navigator.of(context).pop();\r\n'
              '              unawaited(\r\n'
              '                _openExternalUrl(\r\n'
              '                  deleteAccountUrl,\r\n'
              '                  cannotOpenMessage: \'无法打开注销页面\',\r\n'
              '                ),\r\n'
              '              );\r\n'
              '            },\r\n'
              '          ),\r\n'
              '        ],\r\n'
              '      ),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  @override\r\n'
              '  Widget build(BuildContext context) {\r\n'
              '    final data = _buildAccountPageViewModel();\r\n'
              '    final userActivity = AdaptiveUserActivity(\r\n'
              '      key: ValueKey<String>(username),\r\n'
              '    );\r\n'
              '    if (_isPhoneSurface) {\r\n'
              '      return _buildCupertinoAccountPage(data, userActivity);\r\n'
              '    }\r\n'
              '\r\n'
              '    return fluent.FluentTheme(\r\n'
              '      data: _buildFluentThemeData(context),\r\n'
              '      child: DesktopAccountView(data: data, userActivity: userActivity),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  AccountPageViewModel _buildAccountPageViewModel() {\r\n'
              '    return AccountPageViewModel(\r\n'
              '      dandanplay: DandanplayAccountViewModel(\r\n'
              '        isLoggedIn: isLoggedIn,\r\n'
              '        username: username.isEmpty ? \'未登录\' : username,\r\n'
              '        avatarUrl: avatarUrl,\r\n'
              '        isLoading: isLoading,\r\n'
              '        onLogin: showLoginDialog,\r\n'
              '        onRegister: showRegisterDialog,\r\n'
              '        onLogout: performLogout,\r\n'
              '        onDeleteAccount: startDeleteAccount,\r\n'
              '      ),\r\n'
              '      bangumi: BangumiAccountViewModel(\r\n'
              '        isAuthorized: isBangumiLoggedIn,\r\n'
              '        userInfo: bangumiUserInfo,\r\n'
              '        isDandanplayLoggedIn: isLoggedIn,\r\n'
              '        dandanLinkedInfo: dandanLinkedBangumiInfo,\r\n'
              '        dandanLinkedExpireTime: dandanLinkedBangumiExpireTime,\r\n'
              '        isRequestingDandanAuth: isRequestingDandanBangumiAuth,\r\n'
              '        isRefreshingDandanStatus: _isRefreshingDandanBangumiStatus,\r\n'
              '        isLoading: isLoading,\r\n'
              '        isSyncing: isBangumiSyncing,\r\n'
              '        syncStatus: bangumiSyncStatus,\r\n'
              '        lastSyncTime: lastBangumiSyncTime,\r\n'
              '        tokenController: bangumiTokenController,\r\n'
              '        onRequestDandanAuth: _startDandanBangumiAuthorize,\r\n'
              '        onOpenDandanManage: _openDandanBangumiManagePage,\r\n'
              '        onRefreshDandanStatus: _manualRefreshDandanBangumiStatus,\r\n'
              '        onSaveToken: saveBangumiToken,\r\n'
              '        onClearToken: clearBangumiToken,\r\n'
              '        onSync: () => performBangumiSync(forceFullSync: false),\r\n'
              '        onFullSync: () => performBangumiSync(forceFullSync: true),\r\n'
              '        onTestConnection: testBangumiConnection,\r\n'
              '        onClearCache: clearBangumiSyncCache,\r\n'
              '        onOpenDandanHelp: () => _showBangumiSyncHelpDialog(\r\n'
              '          _BangumiSyncHelpService.dandanplay,\r\n'
              '        ),\r\n'
              '        onOpenNipaplayHelp: () => _showBangumiSyncHelpDialog(\r\n'
              '          _BangumiSyncHelpService.nipaplay,\r\n'
              '        ),\r\n'
              '      ),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  Widget _buildCupertinoAccountPage(\r\n'
              '    AccountPageViewModel data,\r\n'
              '    Widget userActivity,\r\n'
              '  ) {\r\n'
              '    return ColoredBox(\r\n'
              '      color: Colors.transparent,\r\n'
              '      child: CustomScrollView(\r\n'
              '        physics: const BouncingScrollPhysics(\r\n'
              '          parent: AlwaysScrollableScrollPhysics(),\r\n'
              '        ),\r\n'
              '        slivers: [\r\n'
              '          const SliverToBoxAdapter(\r\n'
              '            child: CupertinoAppPageHeader(\r\n'
              '              title: AccountPageViewModel.title,\r\n'
              '              bottomPadding: 14,\r\n'
              '            ),\r\n'
              '          ),\r\n'
              '          SliverToBoxAdapter(\r\n'
              '            child: Padding(\r\n'
              '              padding: const EdgeInsets.fromLTRB(20, 0, 20, 24),\r\n'
              '              child: Column(\r\n'
              '                crossAxisAlignment: CrossAxisAlignment.stretch,\r\n'
              '                children: [\r\n'
              '                  AdaptiveSegmentedControl(\r\n'
              '                    labels: const [\r\n'
              '                      AccountPageViewModel.dandanplayLabel,\r\n'
              '                      AccountPageViewModel.bangumiLabel,\r\n'
              '                    ],\r\n'
              '                    selectedIndex: _showDandanplayPhoneSection ? 0 : 1,\r\n'
              '                    onValueChanged: (index) {\r\n'
              '                      setState(() => _showDandanplayPhoneSection = index == 0);\r\n'
              '                    },\r\n'
              '                  ),\r\n'
              '                  const SizedBox(height: 24),\r\n'
              '                  AnimatedSwitcher(\r\n'
              '                    duration: const Duration(milliseconds: 220),\r\n'
              '                    child: _showDandanplayPhoneSection\r\n'
              '                        ? CupertinoDandanplayAccountSection(\r\n'
              '                            key: const ValueKey<String>(\'dandanplay-account\'),\r\n'
              '                            data: data.dandanplay,\r\n'
              '                            userActivity: userActivity,\r\n'
              '                          )\r\n'
              '                        : CupertinoBangumiSection(\r\n'
              '                            key: const ValueKey<String>(\'bangumi-account\'),\r\n'
              '                            data: data.bangumi,\r\n'
              '                          ),\r\n'
              '                  ),\r\n'
              '                ],\r\n'
              '              ),\r\n'
              '            ),\r\n'
              '          ),\r\n'
              '          const SliverPadding(padding: EdgeInsets.only(bottom: 84)),\r\n'
              '        ],\r\n'
              '      ),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  Future<void> _showFluentLoginDialog({\r\n'
              '    required String title,\r\n'
              '    required List<LoginField> fields,\r\n'
              '    required String actionText,\r\n'
              '    required Future<LoginResult> Function(Map<String, String> values) onSubmit,\r\n'
              '  }) {\r\n'
              '    return BlurLoginDialog.show(\r\n'
              '      context,\r\n'
              '      title: title,\r\n'
              '      fields: fields,\r\n'
              '      loginButtonText: actionText,\r\n'
              '      onLogin: onSubmit,\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  Future<String?> _showCupertinoInputDialog({\r\n'
              '    required String title,\r\n'
              '    required String message,\r\n'
              '    required String placeholder,\r\n'
              '    required String confirmLabel,\r\n'
              '    String initialValue = \'\',\r\n'
              '    bool obscureText = false,\r\n'
              '    TextInputType keyboardType = TextInputType.text,\r\n'
              '  }) async {\r\n'
              '    final result = await AdaptiveAlertDialog.inputShow(\r\n'
              '      context: context,\r\n'
              '      title: title,\r\n'
              '      message: message,\r\n'
              '      input: AdaptiveAlertDialogInput(\r\n'
              '        placeholder: placeholder,\r\n'
              '        initialValue: initialValue,\r\n'
              '        keyboardType: keyboardType,\r\n'
              '        obscureText: obscureText,\r\n'
              '      ),\r\n'
              '      actions: [\r\n'
              '        AlertAction(\r\n'
              '          title: \'取消\',\r\n'
              '          style: AlertActionStyle.cancel,\r\n'
              '          onPressed: () {},\r\n'
              '        ),\r\n'
              '        AlertAction(\r\n'
              '          title: confirmLabel,\r\n'
              '          style: AlertActionStyle.primary,\r\n'
              '          onPressed: () {},\r\n'
              '        ),\r\n'
              '      ],\r\n'
              '    );\r\n'
              '    final trimmed = result?.trim();\r\n'
              '    return trimmed == null || trimmed.isEmpty ? null : trimmed;\r\n'
              '  }\r\n'
              '\r\n'
              '  Future<void> _showCupertinoLoginDialog() async {\r\n'
              '    final account = await _showCupertinoInputDialog(\r\n'
              '      title: \'登录弹弹play账号\',\r\n'
              '      message: \'请输入用户名或邮箱\',\r\n'
              '      placeholder: \'用户名/邮箱\',\r\n'
              '      confirmLabel: \'下一步\',\r\n'
              '      initialValue: usernameController.text,\r\n'
              '      keyboardType: TextInputType.emailAddress,\r\n'
              '    );\r\n'
              '    if (account == null || !mounted) return;\r\n'
              '    usernameController.text = account;\r\n'
              '\r\n'
              '    final password = await _showCupertinoInputDialog(\r\n'
              '      title: \'登录弹弹play账号\',\r\n'
              '      message: \'请输入密码\',\r\n'
              '      placeholder: \'密码\',\r\n'
              '      confirmLabel: \'登录\',\r\n'
              '      obscureText: true,\r\n'
              '    );\r\n'
              '    if (password == null || !mounted) return;\r\n'
              '    passwordController.text = password;\r\n'
              '    await performLogin();\r\n'
              '  }\r\n'
              '\r\n'
              '  Future<void> _showCupertinoRegisterDialog() async {\r\n'
              '    final account = await _showCupertinoInputDialog(\r\n'
              '      title: \'注册弹弹play账号\',\r\n'
              '      message: \'请输入用户名（5-20位英文或数字，首位不能为数字）\',\r\n'
              '      placeholder: \'用户名\',\r\n'
              '      confirmLabel: \'下一步\',\r\n'
              '      initialValue: registerUsernameController.text,\r\n'
              '    );\r\n'
              '    if (account == null || !mounted) return;\r\n'
              '    registerUsernameController.text = account;\r\n'
              '\r\n'
              '    final password = await _showCupertinoInputDialog(\r\n'
              '      title: \'注册弹弹play账号\',\r\n'
              '      message: \'请输入密码\',\r\n'
              '      placeholder: \'密码\',\r\n'
              '      confirmLabel: \'下一步\',\r\n'
              '      obscureText: true,\r\n'
              '      initialValue: registerPasswordController.text,\r\n'
              '    );\r\n'
              '    if (password == null || !mounted) return;\r\n'
              '    registerPasswordController.text = password;\r\n'
              '\r\n'
              '    final email = await _showCupertinoInputDialog(\r\n'
              '      title: \'注册弹弹play账号\',\r\n'
              '      message: \'请输入邮箱（用于找回密码）\',\r\n'
              '      placeholder: \'邮箱\',\r\n'
              '      confirmLabel: \'下一步\',\r\n'
              '      initialValue: registerEmailController.text,\r\n'
              '      keyboardType: TextInputType.emailAddress,\r\n'
              '    );\r\n'
              '    if (email == null || !mounted) return;\r\n'
              '    registerEmailController.text = email;\r\n'
              '\r\n'
              '    final screenName = await _showCupertinoInputDialog(\r\n'
              '      title: \'注册弹弹play账号\',\r\n'
              '      message: \'请输入昵称（不超过50个字符）\',\r\n'
              '      placeholder: \'昵称\',\r\n'
              '      confirmLabel: \'注册\',\r\n'
              '      initialValue: registerScreenNameController.text,\r\n'
              '    );\r\n'
              '    if (screenName == null || !mounted) return;\r\n'
              '    registerScreenNameController.text = screenName;\r\n'
              '\r\n'
              '    try {\r\n'
              '      await performRegister();\r\n'
              '    } catch (_) {\r\n'
              '      // The controller has already surfaced the registration error.\r\n'
              '    }\r\n'
              '  }\r\n'
              '\r\n'
              '  Future<void> _showBangumiSyncHelpDialog(\r\n'
              '    _BangumiSyncHelpService service,\r\n'
              '  ) async {\r\n'
              '    final isDandanplay = service == _BangumiSyncHelpService.dandanplay;\r\n'
              '    final title = isDandanplay ? \'弹弹play Bangumi同步说明\' : \'NipaPlay Bangumi同步说明\';\r\n'
              '    final message = isDandanplay\r\n'
              '        ? \'这是弹弹play提供的 Bangumi 同步服务，会在你看完后自动同步观看记录。\\n\\n你可以和下方 NipaPlay 的 Bangumi 同步配合使用，也可以按需只使用其中之一。\'\r\n'
              '        : \'这是 NipaPlay 提供的 Bangumi 服务。默认需要你在番剧详情页手动配置观看集数；支持打分和写评价，也支持按钮一键同步。\\n\\n你可以和上方弹弹play同步配合使用，也可以按需只使用其中之一。\';\r\n'
              '\r\n'
              '    if (_isPhoneSurface) {\r\n'
              '      await CupertinoBottomSheet.show<void>(\r\n'
              '        context: context,\r\n'
              '        title: title,\r\n'
              '        heightRatio: 0.55,\r\n'
              '        child: Padding(\r\n'
              '          padding: const EdgeInsets.fromLTRB(20, 12, 20, 24),\r\n'
              '          child: Column(\r\n'
              '            crossAxisAlignment: CrossAxisAlignment.stretch,\r\n'
              '            children: [\r\n'
              '              Text(\r\n'
              '                message,\r\n'
              '                style: CupertinoTheme.of(context).textTheme.textStyle.copyWith(\r\n'
              '                      fontSize: 15,\r\n'
              '                      height: 1.45,\r\n'
              '                    ),\r\n'
              '              ),\r\n'
              '              const SizedBox(height: 16),\r\n'
              '              AdaptiveButton(\r\n'
              '                onPressed: () => Navigator.of(context).pop(),\r\n'
              '                style: AdaptiveButtonStyle.filled,\r\n'
