              '    material.BuildContext context,\r\n'
              '    UnifiedSettingsSurface surface,\r\n'
              '  ) {\r\n'
              '    return pageTitleBuilder(context, surface);\r\n'
              '  }\r\n'
              '\r\n'
              '  bool isVisible(\r\n'
              '    material.BuildContext context,\r\n'
              '    UnifiedSettingsSurface surface,\r\n'
              '  ) {\r\n'
              '    if (visible?.call(context, surface) == false) {\r\n'
              '      return false;\r\n'
              '    }\r\n'
              '    return true;\r\n'
              '  }\r\n'
              '\r\n'
              '  material.Widget buildPage(\r\n'
              '    material.BuildContext context,\r\n'
              '    UnifiedSettingsSurface surface,\r\n'
              '  ) {\r\n'
              '    return AdaptiveSettingsScope(\r\n'
              '      style: surface == UnifiedSettingsSurface.phone\r\n'
              '          ? AdaptiveSettingsStyle.phone\r\n'
              '          : AdaptiveSettingsStyle.desktopTablet,\r\n'
              '      child: UnifiedSettingContent(type: contentType),\r\n'
              '    );\r\n'
              '  }\r\n'
              '\r\n'
              '  material.Widget? subtitleWidget(\r\n'
              '    material.BuildContext context,\r\n'
              '    UnifiedSettingsSurface surface,\r\n'
              '  ) {\r\n'
              '    switch (subtitleType) {\r\n'
              '      case UnifiedSettingSubtitleType.packageVersion:\r\n'
              '        return const _PackageVersionSubtitle();\r\n'
              '      case null:\r\n'
              '        break;\r\n'
              '    }\r\n'
              '    final subtitle = subtitleBuilder?.call(context, surface);\r\n'
              '    if (subtitle == null || subtitle.trim().isEmpty) {\r\n'
              '      return null;\r\n'
              '    }\r\n'
              '    return material.Text(subtitle);\r\n'
              '  }\r\n'
              '}\r\n'
              '\r\n'
              'List<UnifiedSettingEntry> buildUnifiedSettingEntries(\r\n'
              '  material.BuildContext context, {\r\n'
              '  required UnifiedSettingsSurface surface,\r\n'
              '}) {\r\n'
              '  // Plugin capabilities can change while the settings sheet keeps its root\r\n'
              '  // page alive. Observe them here so every surface regenerates the same list.\r\n'
              '  context.watch<PluginService>();\r\n'
              '  return _buildUnifiedSettingEntryDefinitions()\r\n'
              '      .where((entry) => entry.isVisible(context, surface))\r\n'
              '      .toList();\r\n'
              '}\r\n'
              '\r\n'
              'String unifiedSettingSectionTitle(\r\n'
              '  material.BuildContext context,\r\n'
              '  UnifiedSettingSection section,\r\n'
              ') {\r\n'
              '  switch (section) {\r\n'
              '    case UnifiedSettingSection.general:\r\n'
              '      return context.l10n.settingsBasicSection;\r\n'
              '    case UnifiedSettingSection.labs:\r\n'
              '      return _text(context, \'实验室\', \'實驗室\', \'Labs\');\r\n'
              '    case UnifiedSettingSection.about:\r\n'
              '      return context.l10n.settingsAboutSection;\r\n'
              '  }\r\n'
              '}\r\n'
              '\r\n'
              'class UnifiedCupertinoSettingsSectionView extends material.StatelessWidget {\r\n'
              '  const UnifiedCupertinoSettingsSectionView({\r\n'
              '    super.key,\r\n'
              '    required this.section,\r\n'
              '    required this.entries,\r\n'
              '  });\r\n'
              '\r\n'
              '  final UnifiedSettingSection section;\r\n'
              '  final List<UnifiedSettingEntry> entries;\r\n'
              '\r\n'
              '  @override\r\n'
              '  material.Widget build(material.BuildContext context) {\r\n'
              '    if (entries.isEmpty) {\r\n'
              '      return const material.SizedBox.shrink();\r\n'
              '    }\r\n'
              '\r\n'
              '    final textStyle =\r\n'
              '        cupertino.CupertinoTheme.of(context).textTheme.textStyle.copyWith(\r\n'
              '              fontSize: 13,\r\n'
              '              color: cupertino.CupertinoDynamicColor.resolve(\r\n'
              '                cupertino.CupertinoColors.systemGrey,\r\n'
              '                context,\r\n'
              '              ),\r\n'
              '              letterSpacing: 0.2,\r\n'
              '            );\r\n'
              '\r\n'
              '    return material.Column(\r\n'
              '      crossAxisAlignment: material.CrossAxisAlignment.start,\r\n'
              '      children: [\r\n'
              '        material.Padding(\r\n'
              '          padding: const material.EdgeInsets.symmetric(horizontal: 20),\r\n'
              '          child: material.Text(\r\n'
              '            unifiedSettingSectionTitle(context, section),\r\n'
              '            style: textStyle,\r\n'
              '          ),\r\n'
              '        ),\r\n'
              '        const material.SizedBox(height: 8),\r\n'
              '        CupertinoSettingsGroupCard(\r\n'
              '          addDividers: true,\r\n'
              '          backgroundColor: resolveSettingsSectionBackground(context),\r\n'
              '          children: [\r\n'
              '            for (final entry in entries)\r\n'
              '              UnifiedCupertinoSettingHomeTile(entry: entry),\r\n'
              '          ],\r\n'
              '        ),\r\n'
              '      ],\r\n'
              '    );\r\n'
              '  }\r\n'
              '}\r\n'
              '\r\n'
              'class UnifiedCupertinoSettingHomeTile extends material.StatefulWidget {\r\n'
              '  const UnifiedCupertinoSettingHomeTile({\r\n'
              '    super.key,\r\n'
              '    required this.entry,\r\n'
              '  });\r\n'
              '\r\n'
              '  final UnifiedSettingEntry entry;\r\n'
              '\r\n'
              '  @override\r\n'
              '  material.State<UnifiedCupertinoSettingHomeTile> createState() =>\r\n'
              '      _UnifiedCupertinoSettingHomeTileState();\r\n'
              '}\r\n'
              '\r\n'
              'class _UnifiedCupertinoSettingHomeTileState\r\n'
              '    extends material.State<UnifiedCupertinoSettingHomeTile> {\r\n'
              '  @override\r\n'
              '  material.Widget build(material.BuildContext context) {\r\n'
              '    return CupertinoSettingsTile(\r\n'
              '      leading: material.Icon(\r\n'
              '        widget.entry.phoneIcon ?? widget.entry.icon,\r\n'
              '        color: resolveSettingsIconColor(context),\r\n'
              '      ),\r\n'
              '      title: material.Text(\r\n'
              '        widget.entry.title(context, UnifiedSettingsSurface.phone),\r\n'
              '      ),\r\n'
              '      subtitle: widget.entry.subtitleWidget(\r\n'
              '        context,\r\n'
              '        UnifiedSettingsSurface.phone,\r\n'
              '      ),\r\n'
              '      backgroundColor: resolveSettingsTileBackground(context),\r\n'
              '      showChevron: true,\r\n'
              '      onTap: () async {\r\n'
              '        await openUnifiedCupertinoSettingEntry(context, widget.entry);\r\n'
              '        if (!mounted) return;\r\n'
              '        setState(() {});\r\n'
              '      },\r\n'
              '    );\r\n'
              '  }\r\n'
              '}\r\n'
              '\r\n'
              'Future<void> openUnifiedCupertinoSettingEntry(\r\n'
              '  material.BuildContext context,\r\n'
              '  UnifiedSettingEntry entry,\r\n'
              ') {\r\n'
              '  return CupertinoBottomSheetPageNavigator.push<void>(\r\n'
              '    context,\r\n'
              '    title: entry.pageTitle(context, UnifiedSettingsSurface.phone),\r\n'
              '    builder: (routeContext) => entry.buildPage(\r\n'
              '      routeContext,\r\n'
              '      UnifiedSettingsSurface.phone,\r\n'
              '    ),\r\n'
              '  );\r\n'
              '}\r\n'
              '\r\n'
              'List<UnifiedSettingEntry> _buildUnifiedSettingEntryDefinitions() {\r\n'
              '  return [\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.appearance,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.appearance,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.appearanceSettings,\r\n'
              '      subtitleBuilder: (context, surface) => _themeModeLabel(context),\r\n'
              '      icon: Ionicons.color_palette_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.paintbrush,\r\n'
              '      contentType: UnifiedSettingContentType.appearance,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.language,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.language,\r\n'
              '      pageTitleBuilder: (context, surface) =>\r\n'
              '          context.l10n.languageSettingsTitle,\r\n'
              '      subtitleBuilder: (context, surface) {\r\n'
              '        final provider = context.watch<AppLanguageProvider>();\r\n'
              '        return context.l10n.currentLanguage(\r\n'
              '          _languageModeLabel(context, provider.mode),\r\n'
              '        );\r\n'
              '      },\r\n'
              '      icon: Ionicons.language_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.globe,\r\n'
              '      contentType: UnifiedSettingContentType.language,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.general,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.general,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.generalSettings,\r\n'
              '      icon: Ionicons.settings_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.settings,\r\n'
              '      contentType: UnifiedSettingContentType.general,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.storage,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.storage,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.storageSettings,\r\n'
              '      subtitleBuilder: (context, surface) =>\r\n'
              '          context.l10n.storageSettingsSubtitle,\r\n'
              '      icon: Ionicons.folder_open_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.archivebox,\r\n'
              '      contentType: UnifiedSettingContentType.storage,\r\n'
              '      visible: (context, surface) => !globals.isTelevision,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.network,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.networkSettings,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.networkSettings,\r\n'
              '      subtitleBuilder: (context, surface) =>\r\n'
              '          context.l10n.networkSettingsSubtitle,\r\n'
              '      icon: Ionicons.wifi_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.globe,\r\n'
              '      contentType: UnifiedSettingContentType.network,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.backupRestore,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.backupAndRestore,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.backupAndRestore,\r\n'
              '      icon: Ionicons.cloud_upload_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.cloud_upload,\r\n'
              '      contentType: UnifiedSettingContentType.backupRestore,\r\n'
              '      visible: (context, surface) => !globals.isTelevision,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.player,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.player,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.playerSettings,\r\n'
              '      subtitleBuilder: (context, surface) =>\r\n'
              '          _playerKernelLabel(context, PlayerFactory.getKernelType()),\r\n'
              '      icon: Ionicons.play_circle_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.play_circle,\r\n'
              '      contentType: UnifiedSettingContentType.player,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.danmaku,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => _text(context, \'弹幕\', \'彈幕\', \'Danmaku\'),\r\n'
              '      pageTitleBuilder: (context, surface) =>\r\n'
              '          _text(context, \'弹幕设置\', \'彈幕設定\', \'Danmaku Settings\'),\r\n'
              '      subtitleBuilder: (context, surface) => _text(\r\n'
              '        context,\r\n'
              '        \'渲染、防剧透与匹配\',\r\n'
              '        \'渲染、防劇透與匹配\',\r\n'
              '        \'Rendering, spoiler filtering, and matching.\',\r\n'
              '      ),\r\n'
              '      icon: Ionicons.hardware_chip_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.bubble_left_bubble_right,\r\n'
              '      contentType: UnifiedSettingContentType.danmaku,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.externalPlayer,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.externalCall,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.externalCall,\r\n'
              '      subtitleBuilder: (context, surface) {\r\n'
              '        final externalSupported = globals.isDesktop;\r\n'
              '        if (!externalSupported) {\r\n'
              '          return context.l10n.desktopOnlySupported;\r\n'
              '        }\r\n'
              '        final settingsProvider = context.watch<SettingsProvider>();\r\n'
              '        return settingsProvider.useExternalPlayer\r\n'
              '            ? context.l10n.externalPlayerEnabled\r\n'
              '            : context.l10n.externalPlayerDisabled;\r\n'
              '      },\r\n'
              '      icon: Ionicons.open_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.square_arrow_up,\r\n'
              '      contentType: UnifiedSettingContentType.externalPlayer,\r\n'
              '      visible: (context, surface) => !globals.isTelevision && !globals.isTablet,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.shortcuts,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.shortcuts,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.shortcutsSettings,\r\n'
              '      icon: Ionicons.key_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.keyboard,\r\n'
              '      contentType: UnifiedSettingContentType.shortcuts,\r\n'
              '      visible: (context, surface) =>\r\n'
              '          surface == UnifiedSettingsSurface.desktopTablet &&\r\n'
              '          !globals.isPhone &&\r\n'
              '          !globals.isTablet &&\r\n'
              '          !globals.isTelevision,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.remoteAccess,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.remoteAccess,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.remoteAccess,\r\n'
              '      subtitleBuilder: (context, surface) => _text(\r\n'
              '        context,\r\n'
              '        \'本机被控端、共享媒体库与局域网遥控器\',\r\n'
              '        \'本機被控端、共享媒體庫與區域網路遙控器\',\r\n'
              '        \'Receiver, shared library, and LAN remote control.\',\r\n'
              '      ),\r\n'
              '      icon: Ionicons.link_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.dot_radiowaves_left_right,\r\n'
              '      contentType: UnifiedSettingContentType.remoteAccess,\r\n'
              '      visible: (context, surface) => !kIsWeb && !globals.isTelevision,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.remoteMediaLibrary,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) =>\r\n'
              '          surface == UnifiedSettingsSurface.phone\r\n'
              '              ? context.l10n.networkMediaLibrary\r\n'
              '              : context.l10n.remoteMediaLibrary,\r\n'
              '      pageTitleBuilder: (context, surface) =>\r\n'
              '          surface == UnifiedSettingsSurface.phone\r\n'
              '              ? context.l10n.networkMediaLibrary\r\n'
              '              : context.l10n.remoteMediaLibrary,\r\n'
              '      subtitleBuilder: _mediaServerSubtitle,\r\n'
              '      icon: Ionicons.library_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.cloud,\r\n'
              '      contentType: UnifiedSettingContentType.remoteMediaLibrary,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.downloader,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.tabTorrentDownload,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.tabTorrentDownload,\r\n'
              '      subtitleBuilder: (context, surface) => _text(\r\n'
              '        context,\r\n'
              '        \'下载任务、设置\',\r\n'
              '        \'下載任務、設定\',\r\n'
              '        \'Download tasks and settings.\',\r\n'
              '      ),\r\n'
              '      icon: Ionicons.cloud_download_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.arrow_down_circle,\r\n'
              '      contentType: UnifiedSettingContentType.downloader,\r\n'
              '      visible: (context, surface) => globals.isDownloaderSupportedPlatform,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.developerOptions,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.developerOptions,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.developerOptions,\r\n'
              '      subtitleBuilder: (context, surface) =>\r\n'
              '          context.l10n.developerOptionsSubtitle,\r\n'
              '      icon: Ionicons.code_slash_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.command,\r\n'
              '      contentType: UnifiedSettingContentType.developerOptions,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.labs,\r\n'
              '      section: UnifiedSettingSection.labs,\r\n'
              '      titleBuilder: (context, surface) => _text(context, \'实验室\', \'實驗室\', \'Labs\'),\r\n'
              '      pageTitleBuilder: (context, surface) =>\r\n'
              '          _text(context, \'实验室\', \'實驗室\', \'Labs\'),\r\n'
              '      subtitleBuilder: (context, surface) => _text(\r\n'
              '        context,\r\n'
              '        \'实验性功能与开关\',\r\n'
              '        \'實驗性功能與開關\',\r\n'
              '        \'Experimental features and switches.\',\r\n'
              '      ),\r\n'
              '      icon: Ionicons.flask_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.lab_flask,\r\n'
              '      contentType: UnifiedSettingContentType.labs,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.plugins,\r\n'
              '      section: UnifiedSettingSection.general,\r\n'
              '      titleBuilder: (context, surface) => _text(context, \'插件\', \'插件\', \'Plugins\'),\r\n'
              '      pageTitleBuilder: (context, surface) =>\r\n'
              '          _text(context, \'插件设置\', \'插件設定\', \'Plugin Settings\'),\r\n'
              '      subtitleBuilder: (context, surface) => _text(\r\n'
              '        context,\r\n'
              '        \'管理 JS 插件并配置启用状态\',\r\n'
              '        \'管理 JS 插件並配置啟用狀態\',\r\n'
              '        \'Manage JavaScript plugins and enabled states.\',\r\n'
              '      ),\r\n'
              '      icon: Ionicons.extension_puzzle_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.cube_box,\r\n'
              '      contentType: UnifiedSettingContentType.plugins,\r\n'
              '    ),\r\n'
              '    UnifiedSettingEntry(\r\n'
              '      id: UnifiedSettingEntryIds.about,\r\n'
              '      section: UnifiedSettingSection.about,\r\n'
              '      titleBuilder: (context, surface) => context.l10n.about,\r\n'
              '      pageTitleBuilder: (context, surface) => context.l10n.about,\r\n'
              '      subtitleType: UnifiedSettingSubtitleType.packageVersion,\r\n'
              '      icon: Ionicons.information_circle_outline,\r\n'
              '      phoneIcon: cupertino.CupertinoIcons.info_circle,\r\n'
              '      contentType: UnifiedSettingContentType.about,\r\n'
              '    ),\r\n'
              '  ];\r\n'
              '}\r\n'
              '\r\n'
              'String _themeModeLabel(material.BuildContext context) {\r\n'
              '  final themeMode = context.watch<ThemeNotifier>().themeMode;\r\n'
              '  switch (themeMode) {\r\n'
              '    case material.ThemeMode.light:\r\n'
              '      return context.l10n.lightMode;\r\n'
              '    case material.ThemeMode.dark:\r\n'
              '      return context.l10n.darkMode;\r\n'
              '    case material.ThemeMode.system:\r\n'
              '      return context.l10n.followSystem;\r\n'
              '  }\r\n'
              '}\r\n'
              '\r\n'
              'String _languageModeLabel(\r\n'
              '  material.BuildContext context,\r\n'
              '  AppLanguageMode mode,\r\n'
              ') {\r\n'
              '  switch (mode) {\r\n'
              '    case AppLanguageMode.simplifiedChinese:\r\n'
              '      return context.l10n.languageSimplifiedChinese;\r\n'
              '    case AppLanguageMode.traditionalChinese:\r\n'
              '      return context.l10n.languageTraditionalChinese;\r\n'
              '    case AppLanguageMode.english:\r\n'
              '      return context.l10n.languageEnglish;\r\n'
              '    case AppLanguageMode.auto:\r\n'
              '      return context.l10n.languageAuto;\r\n'
              '  }\r\n'
              '}\r\n'
              '\r\n'
              'String _playerKernelLabel(\r\n'
              '  material.BuildContext context,\r\n'
              '  PlayerKernelType type,\r\n'
              ') {\r\n'
              '  switch (type) {\r\n'
              '    case PlayerKernelType.mdk:\r\n'
              '      return context.l10n.playerKernelCurrentMdk;\r\n'
              '    case PlayerKernelType.videoPlayer:\r\n'
              '      return context.l10n.playerKernelCurrentVideoPlayer;\r\n'
              '    case PlayerKernelType.mediaKit:\r\n'
              '      return context.l10n.playerKernelCurrentLibmpv;\r\n'
              '    case PlayerKernelType.erika:\r\n'
              '      return _text(context, \'当前：Erika\', \'目前：Erika\', \'Current: Erika\');\r\n'
              '  }\r\n'
              '}\r\n'
              '\r\n'
              'String _mediaServerSubtitle(\r\n'
              '  material.BuildContext context,\r\n'
              '  UnifiedSettingsSurface surface,\r\n'
              ') {\r\n'
